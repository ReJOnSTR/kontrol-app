generator client {
  provider = "prisma-client-js"
  output   = "../electron/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model assignments {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int?
  item_name   String
  quantity    Int?      @default(1)
  assigned_to String?
  department  String?
  start_date  DateTime
  end_date    DateTime?
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  vehicles    vehicles? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_assignments_vehicle")
}

model companies {
  id                     Int                      @id @default(autoincrement())
  user_id                Int?
  name                   String
  tax_number             String?
  tax_office             String?
  sgk_no                 String?
  address                String?
  phone                  String?
  signature_path         String?
  stamp_path             String?
  plan                   String?                  @default("PRO")
  status                 String?                  @default("active")
  expires_at             DateTime?
  max_vehicles           Int?                     @default(50)
  max_employees          Int?                     @default(50)
  max_users              Int?                     @default(10)
  storage_limit_mb       Int?                     @default(1024)
  created_at             DateTime?                @default(now())
  users                  users?                   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  employees              employees[]
  meal_settings          meal_settings?
  meal_tickets           meal_tickets[]
  recurring_transactions recurring_transactions[]
  transactions           transactions[]
  vehicles               vehicles[]
  works                  works[]
  customers              customers[]
  departments            departments[]
  leave_types            leave_types[]
  document_categories    document_categories[]
  vehicle_types          vehicle_types[]
  document_folders       document_folders[]
  meal_price_history     meal_price_history[]
  public_holidays        public_holidays[]
  roles                  roles[]
  audit_logs             audit_logs[]
  requests               requests[]

  @@index([user_id], map: "idx_companies_user")
}

model customers {
  id          Int       @id @default(autoincrement())
  company_id  Int
  name        String
  phone       String?
  email       String?
  address     String?
  tax_number  String?
  tax_office  String?
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works       works[]

  @@index([company_id], map: "idx_customers_company")
}

model documents {
  id           Int       @id @default(autoincrement())
  vehicle_id   Int?
  related_type String?
  related_id   Int?
  file_name    String
  file_path    String
  file_type    String?
  doc_type     String?
  category     String?
  folder       String?
  start_date   DateTime?
  end_date     DateTime?
  created_at   DateTime? @default(now())
  is_archived  Int?      @default(0)
  vehicles     vehicles? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model employee_assignments {
  id            Int       @id @default(autoincrement())
  employee_id   Int
  item_name     String
  serial_number String?
  quantity      Int?      @default(1)
  assign_date   DateTime?
  return_date   DateTime?
  status        String?   @default("active")
  notes         String?
  created_at    DateTime? @default(now())
  is_archived   Int?      @default(0)
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_assignments_employee")
}

model employee_attendance {
  id          Int       @id @default(autoincrement())
  employee_id Int
  date        DateTime
  status      String
  description String?
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, date], map: "sqlite_autoindex_employee_attendance_1")
}

model employee_documents {
  id          Int       @id @default(autoincrement())
  employee_id Int
  file_name   String
  file_path   String
  file_type   String?
  category    String?
  folder      String?
  issue_date  DateTime?
  start_date  DateTime?
  expiry_date DateTime?
  is_archived Int?      @default(0)
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_documents_employee")
}

model employee_movements {
  id             Int       @id @default(autoincrement())
  employee_id    Int
  type           String
  amount         Float?    @default(0)
  date           DateTime
  description    String?
  is_paid        Int?      @default(0)
  created_at     DateTime? @default(now())
  payment_method String?   @default("cash")
  employees      employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model employee_salary_history {
  id          Int       @id @default(autoincrement())
  employee_id Int
  amount      Float?    @default(0)
  start_date  DateTime
  end_date    DateTime?
  type        String?   @default("initial")
  description String?
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_salary_history_employee")
}

model employees {
  id                      Int                       @id @default(autoincrement())
  company_id              Int
  first_name              String
  last_name               String
  tc_no                   String?
  phone                   String?
  email                   String?
  position                String?
  department              String?
  start_date              DateTime?
  end_date                DateTime?
  salary                  Float?                    @default(0)
  status                  String?                   @default("active")
  notes                   String?
  image                   String?
  signature_path          String?
  is_archived             Int?                      @default(0)
  created_at              DateTime?                 @default(now())
  past_used_leaves        Int?                      @default(0)
  birth_date              DateTime?
  devir_izin_bakiyesi     Int?                      @default(0)
  devir_maas_bakiyesi     Float?                    @default(0)
  devir_tarihi            DateTime?
  iban                    String?
  off_days                String?                   @default("0")
  user                    users?
  requests                requests[]
  employee_assignments    employee_assignments[]
  employee_attendance     employee_attendance[]
  employee_documents      employee_documents[]
  employee_movements      employee_movements[]
  employee_salary_history employee_salary_history[]
  companies               companies                 @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leaves                  leaves[]
  overtimes               overtimes[]
  salaries                salaries[]
  work_items              work_items[]
  works                   works[]

  @@index([company_id], map: "idx_employees_company")
  @@index([status])
  @@index([is_archived])
}

model inspections {
  id              Int       @id @default(autoincrement())
  vehicle_id      Int
  inspection_date DateTime
  next_inspection DateTime?
  result          String?
  cost            Float?    @default(0)
  notes           String?
  created_at      DateTime? @default(now())
  type            String?   @default("traffic")
  file_path       String?
  is_archived     Int?      @default(0)
  vehicles        vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_inspections_vehicle")
}

model insurances {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int
  company     String
  policy_no   String?
  type        String
  start_date  DateTime
  end_date    DateTime
  premium     Float?    @default(0)
  notes       String?
  created_at  DateTime? @default(now())
  file_path   String?
  is_archived Int?      @default(0)
  vehicles    vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_insurances_vehicle")
}

model leaves {
  id          Int       @id @default(autoincrement())
  employee_id Int
  type        String    @default("annual")
  start_date  DateTime
  end_date    DateTime
  days        Float?    @default(1)
  hours       Float?
  status      String?   @default("approved")
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_leaves_employee")
  @@index([status])
  @@index([is_archived])
}

model maintenances {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int
  type        String
  description String?
  date        DateTime
  cost        Float?    @default(0)
  next_km     Int?
  next_date   DateTime?
  notes       String?
  created_at  DateTime? @default(now())
  file_path   String?
  is_archived Int?      @default(0)
  vehicles    vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_maintenances_vehicle")
}

model meal_settings {
  id               Int       @id @default(autoincrement())
  company_id       Int       @unique(map: "sqlite_autoindex_meal_settings_1")
  price_per_person Float     @default(0)
  created_at       DateTime? @default(now())
  is_archived      Int?      @default(0)
  companies        companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model meal_tickets {
  id               Int       @id @default(autoincrement())
  company_id       Int
  date             DateTime
  person_count     Int       @default(1)
  price_per_person Float?    @default(0)
  notes            String?
  created_at       DateTime? @default(now())
  is_archived      Int?      @default(0)
  companies        companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model meal_price_history {
  id          Int       @id @default(autoincrement())
  company_id  Int
  old_price   Float     @default(0)
  new_price   Float     @default(0)
  change_date DateTime  @default(now())
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model overtimes {
  id          Int       @id @default(autoincrement())
  employee_id Int
  date        DateTime
  hours       Float?    @default(0)
  rate        Float?    @default(1.5)
  amount      Float?    @default(0)
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_overtimes_employee")
  @@index([date])
  @@index([is_archived])
}

model recurring_transactions {
  id            Int       @id @default(autoincrement())
  company_id    Int
  type          String
  method        String?   @default("CASH")
  amount        Float
  category      String?   @default("Diğer")
  description   String?
  frequency     String?   @default("MONTHLY")
  next_run_date DateTime
  is_active     Int?      @default(1)
  created_at    DateTime? @default(now())
  is_archived   Int?      @default(0)
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model salaries {
  id             Int       @id @default(autoincrement())
  employee_id    Int
  period         String
  base_salary    Float?    @default(0)
  bonus          Float?    @default(0)
  deduction      Float?    @default(0)
  net_salary     Float?    @default(0)
  payment_date   DateTime?
  salary_month   String?
  status         String?   @default("pending")
  payment_method String?   @default("cash")
  notes          String?
  created_at     DateTime? @default(now())
  is_archived    Int?      @default(0)
  employees      employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_salaries_employee")
  @@index([salary_month])
  @@index([status])
  @@index([is_archived])
}

model schema_migrations {
  version    Int       @id @default(autoincrement())
  applied_at DateTime? @default(now())
}

model services {
  id           Int       @id @default(autoincrement())
  vehicle_id   Int
  type         String
  service_name String?
  description  String?
  date         DateTime
  km           Int?
  cost         Float?    @default(0)
  notes        String?
  created_at   DateTime? @default(now())
  file_path    String?
  is_archived  Int?      @default(0)
  vehicles     vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_services_vehicle")
}

model transactions {
  id             Int       @id @default(autoincrement())
  company_id     Int
  date           DateTime
  type           String
  category       String?
  amount         Float?    @default(0)
  description    String?
  payment_method String?
  created_at     DateTime? @default(now())
  method         String?   @default("CASH")
  check_number   String?
  check_due_date DateTime?
  status         String?   @default("COMPLETED")
  currency       String?   @default("TRY")
  is_archived    Int?      @default(0)
  companies      companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_transactions_date")
  @@index([company_id], map: "idx_transactions_company")
}

model users {
  id                      Int                 @id @default(autoincrement())
  username                String              @unique(map: "sqlite_autoindex_users_1")
  email                   String              @unique(map: "sqlite_autoindex_users_2")
  full_name               String?
  password_hash           String
  created_at              DateTime?           @default(now())
  role                    String?             @default("user")
  role_id                 Int?
  employee_id             Int?                @unique(map: "sqlite_autoindex_users_3")
  permissions             String?
  must_change_password    Int?                @default(0)
  is_active               Int?                @default(1)
  two_factor_secret       String?
  two_factor_enabled      Int?                @default(0)
  two_factor_backup_codes String?
  companies               companies[]
  employee                employees?          @relation(fields: [employee_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  custom_role             roles?              @relation(fields: [role_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_requests        requests[]          @relation("RequestCreator")
  approval_actions        request_approvals[] @relation("ApprovalActor")
}

model vehicles {
  id           Int            @id @default(autoincrement())
  company_id   Int
  type         String
  plate        String
  brand        String?
  model        String?
  year         Int?
  color        String?
  status       String?        @default("active")
  km           Int?           @default(0)
  image        String?
  notes        String?
  created_at   DateTime?      @default(now())
  is_archived  Int?           @default(0)
  assignments  assignments[]
  documents    documents[]
  inspections  inspections[]
  insurances   insurances[]
  maintenances maintenances[]
  services     services[]
  companies    companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_items   work_items[]
  works        works[]

  @@index([company_id], map: "idx_vehicles_company")
  @@index([status])
  @@index([is_archived])
}

model work_items {
  id              Int        @id @default(autoincrement())
  work_id         Int
  date            DateTime
  receipt_no      String?
  vehicle_id      Int?
  employee_id     Int?
  custom_vehicle  String?
  custom_employee String?
  start_time      String?
  end_time        String?
  hours           Float?     @default(0)
  overtime_hours  Float?     @default(0)
  unit_price      Float?     @default(0)
  travel_price    Float?     @default(0)
  total_price     Float?     @default(0)
  description     String?
  created_at      DateTime?  @default(now())
  is_archived     Int?       @default(0)
  employees       employees? @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  vehicles        vehicles?  @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction)
  works           works      @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_work_items_date")
  @@index([work_id], map: "idx_work_items_work")
}

model works {
  id               Int          @id @default(autoincrement())
  company_id       Int
  vehicle_id       Int?
  employee_id      Int?
  customer_id      Int?
  customer         String?
  title            String?
  description      String?
  status           String?      @default("pending")
  price            Float?       @default(0)
  location         String?
  created_at       DateTime?    @default(now())
  start_date       DateTime?
  end_date         DateTime?
  work_start_time  String?      @default("08:00")
  work_end_time    String?      @default("17:00")
  is_archived      Int?         @default(0)
  pazar_multiplier Float?       @default(1.5)
  mesai_multiplier Float?       @default(1.5)
  work_items       work_items[]
  employees        employees?   @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  vehicles         vehicles?    @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction)
  companies        companies    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers        customers?   @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([company_id], map: "idx_works_company")
  @@index([customer_id], map: "idx_works_customer")
  @@index([status])
  @@index([is_archived])
}

model departments {
  id         Int       @id @default(autoincrement())
  company_id Int
  name       String
  status     String?   @default("active")
  created_at DateTime? @default(now())
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model leave_types {
  id         Int       @id @default(autoincrement())
  company_id Int
  name       String
  status     String?   @default("active")
  created_at DateTime? @default(now())
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model document_categories {
  id          Int       @id @default(autoincrement())
  company_id  Int
  name        String
  status      String?   @default("active")
  target_type String?   @default("employee")
  created_at  DateTime? @default(now())
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model document_folders {
  id           Int       @id @default(autoincrement())
  company_id   Int
  name         String
  related_type String?
  related_id   Int?
  is_archived  Int?      @default(0)
  created_at   DateTime? @default(now())
  companies    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vehicle_types {
  id         Int       @id @default(autoincrement())
  company_id Int
  name       String
  created_at DateTime? @default(now())
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model public_holidays {
  id          Int       @id @default(autoincrement())
  company_id  Int
  date        DateTime
  description String?
  status      String?   @default("active")
  created_at  DateTime? @default(now())
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_public_holidays_company")
}

model roles {
  id          Int           @id @default(autoincrement())
  company_id  Int
  name        String
  description String?
  created_at  DateTime?     @default(now())
  users       users[]
  permissions permissions[]
  companies   companies     @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_roles_company")
}

model permissions {
  id          Int     @id @default(autoincrement())
  role_id     Int
  module      String
  can_read    Boolean @default(false)
  can_create  Boolean @default(false)
  can_update  Boolean @default(false)
  can_delete  Boolean @default(false)
  can_approve Boolean @default(false)
  scope       String  @default("OWN")
  roles       roles   @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role_id], map: "idx_permissions_role")
}

model requests {
  id            Int                 @id @default(autoincrement())
  company_id    Int
  created_by_id Int
  employee_id   Int
  type          String
  title         String
  description   String?
  request_data  String
  status        String              @default("PENDING")
  current_step  Int                 @default(1)
  total_steps   Int                 @default(1)
  document_path String?
  created_at    DateTime?           @default(now())
  updated_at    DateTime?           @updatedAt
  creator       users               @relation("RequestCreator", fields: [created_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee      employees           @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approvals     request_approvals[]
  companies     companies           @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_requests_company")
  @@index([employee_id], map: "idx_requests_employee")
  @@index([status], map: "idx_requests_status")
}

model request_approvals {
  id          Int       @id @default(autoincrement())
  request_id  Int
  approver_id Int?
  step        Int       @default(1)
  status      String
  comment     String?
  action_date DateTime? @default(now())
  requests    requests  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approver    users?    @relation("ApprovalActor", fields: [approver_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([request_id], map: "idx_request_approvals_request")
}

model system_announcements {
  id             Int       @id @default(autoincrement())
  title          String
  message        String
  type           String?   @default("info")
  company_id     Int?
  created_by     Int?
  is_active      Int?      @default(1)
  is_dismissible Int?      @default(1)
  show_popup     Int?      @default(0)
  expires_at     DateTime?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())

  @@index([company_id], map: "idx_announcements_company")
  @@index([is_active], map: "idx_announcements_active")
}

model audit_logs {
  id          Int       @id @default(autoincrement())
  company_id  Int?
  user_id     Int?
  username    String?
  user_role   String?
  action      String // CREATE, UPDATE, DELETE, LOGIN_SUCCESS, LOGIN_FAILED, IMPERSONATE, SECURITY
  entity_type String // vehicle, employee, transaction, work, user, company, auth
  entity_id   String?
  entity_name String?
  description String
  details     String? // JSON formatted
  ip_address  String?
  user_agent  String?
  severity    String?   @default("info")
  created_at  DateTime? @default(now())

  companies companies? @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([company_id], map: "idx_audit_company")
  @@index([user_id], map: "idx_audit_user")
  @@index([action], map: "idx_audit_action")
  @@index([entity_type], map: "idx_audit_entity")
  @@index([severity], map: "idx_audit_severity")
  @@index([created_at], map: "idx_audit_created")
}

model company_settings {
  company_id    Int       @id
  settings_json String
  updated_at    DateTime? @default(now())
}

model user_preferences {
  user_id          Int       @id
  preferences_json String
  updated_at       DateTime? @default(now())
}
